{
  "version": 2,
  "functions": {
    "api/index.mjs": {
      "maxDuration": 30,
      "includeFiles": "{src/**,data/seed-store.json}"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.mjs"
    },
    {
      "source": "/",
      "destination": "/public/index.html"
    },
    {
      "source": "/((?!api/|public/).*)",
      "destination": "/public/$1"
    }
  ]
}
